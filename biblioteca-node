const { Livro, Usuario, Emprestimo } = require('../models');
async function dashboard(req, res) {
try {
const [totalLivros, totalUsuarios, emprestimosAtivos, livrosDisponiveis] = await Promise.all([
Livro.count(),
Usuario.count(),
Emprestimo.count({ where: { status: 'em_andamento' } }),
Livro.count({ where: { disponivel: true } }),
]);
res.render('dashboard', {
totalLivros,
totalUsuarios,
emprestimosAtivos,
livrosDisponiveis,
});
