Parte 3 — Empréstimos (regra de negócio central)
controllers/emprestimoController.js
const { Emprestimo, Livro } = require('../models');
async function registrarEmprestimo(req, res) {
try {
const { livroId, dataDevolucaoPrevista } = req.body;
const usuarioId = req.usuario.id; // vem do token JWT (middleware autenticar)
const livro = await Livro.findByPk(livroId);
if (!livro) return res.status(404).json({ erro: 'Livro não encontrado' });
if (!livro.disponivel) return res.status(400).json({ erro: 'Livro indisponível para empréstimo' });
const emprestimo = await Emprestimo.create({ livroId, usuarioId, dataDevolucaoPrevista });
await livro.update({ disponivel: false });
res.status(201).json(emprestimo);
} catch (erro) { res.status(400).json({ erro: erro.message }); }
}
async function devolverLivro(req, res) {
try {
const emprestimo = await Emprestimo.findByPk(req.params.id);
if (!emprestimo) return res.status(404).json({ erro: 'Empréstimo não encontrado' });
await emprestimo.update({ status: 'devolvido', dataDevolucaoReal: new Date() });
const livro = await Livro.findByPk(emprestimo.livroId);
await livro.update({ disponivel: true });
res.json(emprestimo);
} catch (erro) { res.status(400).json({ erro: erro.message }); }
}
module.exports = { registrarEmprestimo, devolverLivro };
