async function dashboard(req, res) {
try {
const [totalLivros, totalUsuarios] = await Promise.all([
Livro.count(),
Usuario.count(),
]);
res.json({ totalLivros, totalUsuarios });
} catch (erro) {
res.status(500).json({ erro: erro.message });
}
}
Isso é muito mais eficiente do que fazer 'await Livro.count()' e depois 'await Usuario.count()' separadamente, pois as duas consultas rodam ao 
mesmo tempo. Vamos usar exatamente esse recurso na Aula 10, no Dashboard do Projeto Final.
