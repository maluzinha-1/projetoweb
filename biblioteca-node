const mysql = require('mysql2/promise');
const pool = mysql.createPool({
host: 'localhost',
user: 'root',
password: 'SUA_SENHA_AQUI',
database: 'biblioteca',
});
module.exports = pool;
⚠
 Segurança: Nunca deixe senhas de banco de dados escritas diretamente no código em um projeto real. Use variáveis de ambiente 
com o pacote dotenv (npm install dotenv) e um arquivo .env (que nunca deve ser enviado ao GitHub). Por ora, para fins didáticos, 
vamos manter simples — mas guarde essa boa prática para o Projeto Final.
Passo 6 — Atualizando o Model para usar o banco
models/Livro.js (nova versão com MySQL)
const pool = require('../config/database');
async function listarTodos() {
const [linhas] = await pool.query('SELECT * FROM livros');
return linhas;
}
async function buscarPorId(id) {
const [linhas] = await pool.query('SELECT * FROM livros WHERE id = ?', [id]);
return linhas[0];
}
module.exports = { listarTodos, buscarPorId };
Repare no uso de '?' na query — isso é chamado de prepared statement (consulta parametrizada). NUNCA concatene strings diretamente numa 
query SQL (ex: 
SELECT * FROM livros WHERE id = ${id}), pois isso abre brecha para SQL Injection, um dos ataques mais comuns em sistemas 
web.
Note que agora as funções são async (assíncronas) — vamos aprofundar exatamente esse conceito na Aula 06. Por enquanto, ajuste o 
Controller para usar await antes de chamar cada função do Model, e transforme cada função do Controller em async.
