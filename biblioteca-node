Passo 2 — Criando a API REST completa de Livros
routes/api/livroApi.js
const express = require('express');
const router = express.Router();
const Livro = require('../../models/Livro');
// GET /api/livros
router.get('/', async (req, res) => {
try {
const livros = await Livro.findAll();
res.status(200).json(livros);
} catch (erro) { res.status(500).json({ erro: erro.message }); }
});
// GET /api/livros/:id
router.get('/:id', async (req, res) => {
try {
const livro = await Livro.findByPk(req.params.id);
if (!livro) return res.status(404).json({ erro: 'Livro não encontrado' });
res.status(200).json(livro);
} catch (erro) { res.status(500).json({ erro: erro.message }); }
});
// POST /api/livros
router.post('/', async (req, res) => {
try {
const { titulo, autor } = req.body;
if (!titulo || !autor) { return res.status(400).json({ erro: 'Título e autor são obrigatórios' }); }
const novoLivro = await Livro.create(req.body);
res.status(201).json(novoLivro);
} catch (erro) { res.status(400).json({ erro: erro.message }); }
});
// PUT /api/livros/:id
router.put('/:id', async (req, res) => {
try {
const livro = await Livro.findByPk(req.params.id);
if (!livro) return res.status(404).json({ erro: 'Livro não encontrado' });
await livro.update(req.body);
res.status(200).json(livro);
} catch (erro) { res.status(400).json({ erro: erro.message }); }
});
// PATCH /api/livros/:id/disponibilidade
router.patch('/:id/disponibilidade', async (req, res) => {
try {
const livro = await Livro.findByPk(req.params.id);
if (!livro) return res.status(404).json({ erro: 'Livro não encontrado' });
await livro.update({ disponivel: req.body.disponivel });
res.status(200).json(livro);
} catch (erro) { res.status(400).json({ erro: erro.message }); }
});
// DELETE /api/livros/:id
router.delete('/:id', async (req, res) => {
try {
const livro = await Livro.findByPk(req.params.id);
if (!livro) return res.status(404).json({ erro: 'Livro não encontrado' });
await livro.destroy();
res.status(204).send();
} catch (erro) { res.status(500).json({ erro: erro.message }); }
});
module.exports = router;
