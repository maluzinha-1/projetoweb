Livro.findAll()
.then((livros) => res.json(livros))
.catch((erro) => res.status(500).json({ erro: erro.message }));
}
Depois (com async/await)
// DEPOIS — async/await, muito mais legível
async function index(req, res) {
try {
const livros = await Livro.findAll();
res.json(livros);
} catch (erro) {
res.status(500).json({ erro: erro.message });
}
}
Passo 2 — CRUD com try/catch completo
Vamos garantir que absolutamente todas as funções do controllers/livroController.js tenham tratamento de erro adequado (algo que pulamos 
rapidamente na Aula 05 para focar no Sequelize):
controllers/livroController.js (revisado)
const Livro = require('../models/Livro');
async function index(req, res) {
try {
const livros = await Livro.findAll();
res.json(livros);
} catch (erro) {
res.status(500).json({ erro: 'Erro ao buscar livros', detalhes: erro.message });
}
}
async function show(req, res) {
try {
const livro = await Livro.findByPk(req.params.id);
if (!livro) return res.status(404).json({ erro: 'Livro não encontrado' });
res.json(livro);
} catch (erro) {
res.status(500).json({ erro: 'Erro ao buscar livro', detalhes: erro.message });
}
}
async function store(req, res) {
try {
const novoLivro = await Livro.create(req.body);
res.status(201).json(novoLivro);
} catch (erro) {
res.status(400).json({ erro: 'Erro ao criar livro', detalhes: erro.message });
}
}
module.exports = { index, show, store /* ...update, destroy seguem o mesmo padrão */ };
💡
 Por que status 400 na criação e 500 na busca? Status 400 (Bad Request) indica que o erro foi causado por dados inválidos 
enviados pelo cliente (ex: campo obrigatório faltando). Status 500 (Internal Server Error) indica uma falha do próprio servidor (ex: 
banco de dados fora do ar). Diferenciar esses status ajuda quem consome a API a entender de quem foi a 'culpa' do erro.
Passo 3 — Promise.all() para operações em paralelo
Às vezes precisamos buscar várias coisas ao mesmo tempo, sem que uma espere a outra. Para isso usamos Promise.all():
